{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shrimp.example/schemas/0.1/group-mutation.schema.json",
  "title": "Candidate group mutation or atomic containment edge set",
  "$comment": "Candidate group wire slice; not advertised by the human HTTPS lab. Semantic checks also apply.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
        },
        "replay_window": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
        }
      },
      "required": [
        "id",
        "replay_window"
      ],
      "additionalProperties": false
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "execute_before": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "required_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "commands": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "create_group"
                  },
                  "attributes": {
                    "type": "object",
                    "properties": {
                      "displayName": {
                        "type": "string",
                        "maxLength": 1024
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "action",
                  "attributes"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "delete_group"
                  },
                  "resource": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "group"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "expected_revision": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "action",
                  "resource",
                  "expected_revision"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 1
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "add_containment"
                  },
                  "parent": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "group"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "child": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "group"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "type",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "subject"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "type",
                          "id"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "action",
                  "parent",
                  "child"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "remove_containment"
                  },
                  "resource": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "edge"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "expected_revision": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "action",
                  "resource",
                  "expected_revision"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 8
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "operation",
    "required_capabilities",
    "execute_before",
    "required_dependencies",
    "commands"
  ],
  "additionalProperties": false
}
